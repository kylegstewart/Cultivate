<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The per-user hook only redirects builds explicitly started by Cultivate.
       Normal Visual Studio and command-line builds keep their existing webfarm copy behavior. -->
  <PropertyGroup Condition="'$(CultivateRunDirectory)' != ''">
    <_CultivateRepoRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'MyMeyer.sln'))</_CultivateRepoRoot>
  </PropertyGroup>
  <Import Project="$(CultivateCaptureTargets)"
          Condition="'$(CultivateRunDirectory)' != '' and '$(CultivateCaptureTargets)' != '' and Exists('$(CultivateCaptureTargets)')" />
  <!-- An immutable global /p:WebfarmPath would bypass Cultivate's private build destination. -->
  <PropertyGroup Condition="'$(CultivateRunDirectory)' != '' and '$(_CultivateRepoRoot)' != ''">
    <_CultivateInitialWebfarmPath>$(WebfarmPath)</_CultivateInitialWebfarmPath>
    <_CultivatePropertyProbe>$(CultivateRunDirectory)\PropertyProbe\</_CultivatePropertyProbe>
    <WebfarmPath>$(_CultivatePropertyProbe)</WebfarmPath>
    <_CultivateImmutableWebfarmPath Condition="'$(WebfarmPath)' != '$(_CultivatePropertyProbe)'">true</_CultivateImmutableWebfarmPath>
    <WebfarmPath>$(_CultivateInitialWebfarmPath)</WebfarmPath>
  </PropertyGroup>
  <Target Name="CultivateStageWebfarmCopy" BeforeTargets="CopyBuildOutputToWebfarm"
          Condition="'$(CultivateRunDirectory)' != '' and '$(_CultivateRepoRoot)' != '' and '$(Configuration)' == 'Debug'">
    <Error Condition="!$([System.IO.Path]::IsPathRooted('$(CultivateRunDirectory)')) or !Exists('$(CultivateRunDirectory)\.')"
           Text="Cultivate requires an existing absolute run directory. No webfarm files were copied." />
    <Error Condition="'$(_CultivateCaptureReady)' != 'true'"
           Text="Cultivate's build capture target is missing. Reinstall Cultivate. No webfarm files were copied." />
    <PropertyGroup>
      <_CultivateOriginalWebfarmPath>$(WebfarmPath)</_CultivateOriginalWebfarmPath>
      <_CultivateStage>$(CultivateRunDirectory)\intercepted\$([System.Guid]::NewGuid())\</_CultivateStage>
      <WebfarmPath>$(_CultivateStage)</WebfarmPath>
    </PropertyGroup>
    <Error Condition="'$(_CultivateImmutableWebfarmPath)' == 'true' or '$(WebfarmPath)' != '$(_CultivateStage)'"
           Text="Cultivate cannot redirect a global /p:WebfarmPath. Use the WebfarmPath environment variable for Cultivate builds." />
  </Target>
  <Target Name="CultivateDiscardWebfarmCopy" AfterTargets="CopyBuildOutputToWebfarm"
          Condition="'$(_CultivateStage)' != ''">
    <PropertyGroup>
      <WebfarmPath>$(_CultivateOriginalWebfarmPath)</WebfarmPath>
    </PropertyGroup>
    <RemoveDir Directories="$(_CultivateStage)" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
