<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Cultivate</AssemblyName>
    <RootNamespace>Cultivate</RootNamespace>
    <ApplicationIcon>..\..\assets\Cultivate.ico</ApplicationIcon>
    <!-- The last released version. The Release workflow bumps it; do not edit by hand. -->
    <Version>1.1.1</Version>
    <!-- GitHub repository whose releases "cultivate update" installs. CI passes the building repository. -->
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">kylegstewart/Cultivate</UpdateRepository>
    <Product>Cultivate</Product>
    <Company>Meyer Distributing</Company>
    <Description>Preview, build, and activate a MyMeyer development version on your dev webfarm.</Description>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <!-- Runtime support files stay beside Cultivate.exe (not bundled) so PowerShell and MSBuild can load them. -->
    <None Update="Runtime\*.ps1;Runtime\*.psm1;Runtime\*.targets" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\assets\Cultivate.ico" Link="Cultivate.ico"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
